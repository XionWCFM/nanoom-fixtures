{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["NANOOM_SHARD_INDEX", "NANOOM_SHARD_TOTAL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@nanoom-fixture/unrelated#build": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  },
  "globalDependencies": ["tsconfig.next.json", ".oxfmtrc.json", ".oxlintrc.json"]
}

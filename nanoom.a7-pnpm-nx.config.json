  "globalDependencies": [
    "fixtures/pnpm-nx/pnpm-lock.yaml",
    "fixtures/pnpm-nx/pnpm-workspace.yaml",
    "fixtures/pnpm-nx/nx.json",
    "fixtures/pnpm-nx/nanoom.config.json"
  ]
}

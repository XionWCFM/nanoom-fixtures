{
  "$schema": "https://raw.githubusercontent.com/XionWCFM/nanoom/main/nanoom.schema.json",
  "workspace": { "include": ["packages/*", "tools/*", "services/*"] },
  "affected": { "maxFetchDepth": 32768 },
  "group": {
    "ci": {
      "tasks": ["test"],
      "distribution": {
        "small": { "maxAffectedPercent": 25, "concurrency": 1 },
        "medium": { "maxAffectedPercent": 60, "concurrency": 2 },
        "full": { "maxAffectedPercent": 100, "concurrency": 2 }
      },
      "rules": [
        { "name": "@nanoom-fixture/core", "shard": [{ "task": "test", "shard": 2 }] },
        { "name": "@nanoom-fixture/unrelated", "ignore": true }
      ]
    },
    "scale": {
      "tasks": ["build", "test", "typecheck"],
      "rules": [
        { "name": "@nanoom-fixture/app", "ignore": true },
        { "name": "@nanoom-fixture/core", "ignore": true },
        { "name": "@nanoom-fixture/shared", "ignore": true },
        { "name": "@nanoom-fixture/typescript-configs", "ignore": true },
        { "name": "@nanoom-fixture/unrelated", "ignore": true }
      ]
    }
  },
  "globalDependencies": ["yarn.lock", "turbo.json", "nanoom.config.json"]
}

{
  "name": "nanoom-fixtures",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo build",
    "format": "oxfmt --write .",
    "knip": "knip",
    "lint": "oxlint .",
    "typecheck": "turbo typecheck",
    "prepare": "lefthook install",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "check": "yarn format:check && yarn lint && yarn knip && yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "knip": "catalog:",
    "lefthook": "2.1.14",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "yarn@4.11.0"
}

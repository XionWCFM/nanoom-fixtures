{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*",
    "services/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "verify:install": "node scripts/verify-focused-install.mjs",
    "lint": "oxlint .",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "yarn@4.11.0"
}
